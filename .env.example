# =============================================================================
# Etic'Monts — environment (copy to .env and fill in real values)
# =============================================================================

# ---- Flask -----------------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING
FLASK_ENV=production
APP_TIMEZONE=Europe/Paris

# ---- Modules ---------------------------------------------------------------
# The MAEC / biodiversity core is always on. Optional modules, comma-separated:
#   cout_revient  coût de revient par culture (fraise)
#   marketplace   produits, stocks, clients, commandes, liens clients, tournées
# Use "all" in development. Production currently runs: cout_revient
FEATURES=cout_revient

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=eticmont
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=eticmont
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
# Host port for admin access / backups. Bound to 127.0.0.1 unless POSTGRES_BIND says otherwise.
POSTGRES_EXTERNAL_PORT=5433
POSTGRES_BIND=127.0.0.1
BACKUP_DIR=/home/postgres-backups

# ---- Web -------------------------------------------------------------------
# gunicorn is published on 127.0.0.1:APP_PORT; the host nginx vhost
# (deploy/nginx/emb.boblabs.eu.conf) proxies emb.boblabs.eu to it.
APP_PORT=8085

# ---- Accounts --------------------------------------------------------------
# Code that new producers must enter to register (sent out of band).
REGISTER_TOKEN=CHANGE_ME_TO_A_RANDOM_STRING
# Ensures an admin exists at start-up when none does:
#  - if this user already exists, it is promoted to admin (password unchanged);
#  - otherwise it is created with BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
